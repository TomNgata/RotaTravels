# Rotaract Travel Hacks 2026 - Environment Variables
# Copy to .env for local use; configure the same values in Vercel Project Settings > Environment Variables.

# DATABASE_URL (REQUIRED in production): Postgres connection string.
# Recommended free option: create a database at https://neon.tech or provision
# Vercel Postgres / Neon from the Vercel Marketplace (Storage tab) - the
# integration sets POSTGRES_URL for you automatically.
# Without this variable the API runs with in-memory storage and all
# registrations/questions/hacks are lost when the serverless instance recycles.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ADMIN_TOKEN (recommended): bearer token protecting GET /api/registrations
# (check-in export) and GET /api/questions (moderator view). If unset, those
# endpoints return 401. Use a long random string.
ADMIN_TOKEN="change-me-to-a-long-random-string"
